{
  "name": "phonogeometry",
  "version": "0.1.0",
  "description": "Turn every camera on your phone into a 3D scanner: capture from all lenses at once and reconstruct textured meshes of rooms, people and objects, entirely in the browser.",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:https": "node server.js --https",
    "test": "node --test \"test/**/*.test.js\"",
    "test:conventions": "node --test test/conventions.mjs",
    "check": "npm test && npm run test:conventions",
    "test:e2e": "node test/browser/run.mjs",
    "test:browser": "npm run test:e2e",
    "test:all": "npm test && npm run test:e2e",
    "icons": "node tools/make-icons.js",
    "verify:vendor": "node tools/verify-three.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "private": true
}
